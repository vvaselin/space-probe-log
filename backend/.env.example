DATABASE_URL=sqlite:///./space_probe_log.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_WORLD_SEED=sol-neighborhood-001
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
PROMPT_DIR=app/prompts
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_COOKIE_SECURE=false
ADMIN_SESSION_COOKIE_NAME=space_probe_admin
SIMULATION_TICK_INTERVAL_SECONDS=1.8
SCHEDULER_LEASE_SECONDS=30
SIMULATION_SCHEDULER_ENABLED=true

VOYAGE_LLM_ROUTE_PROVIDER=openai_compatible
VOYAGE_LLM_ROUTE_BASE_URL=https://llm.ryuchan.dev/v1
VOYAGE_LLM_ROUTE_MODEL=gpt-oss-20b
VOYAGE_LLM_ROUTE_API_KEY=
VOYAGE_LLM_LOG_PROVIDER=openai_compatible
VOYAGE_LLM_LOG_BASE_URL=https://llm.ryuchan.dev/v1
